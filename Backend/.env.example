NODE_ENV=development
PORT=4000
# Comma-separated origins for production. In development, localhost and private LAN IPv4 origins on port 5173 are allowed.
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=dhulikhel_citizen_registry
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Seed credentials are optional, but provide both values for each account to seed it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MAYOR_EMAIL=
SEED_MAYOR_PASSWORD=
SEED_WARD_1_EMAIL=
SEED_WARD_1_PASSWORD=
